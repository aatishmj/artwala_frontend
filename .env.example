# Frontend Environment Variables (Next.js)
# Copy this file to one of:
#   .env.local            (local development, ignored by git)
#   .env.development      (optional environment-specific)
#   .env.production       (production build-time)
# and adjust values as needed.
#
# IMPORTANT:
# - Any variable prefixed with NEXT_PUBLIC_ is exposed to the browser bundle.
# - Do NOT put secrets (API keys, SMTP passwords, DB creds) in NEXT_PUBLIC_ values.
# - For server-only logic, use unprefixed variables (accessible only in Server Components / edge runtime),
#   but avoid placing sensitive backend credentials here—keep them in the Django backend .env instead.

#############################################
# 1. API Base URL
#############################################
# If your frontend is served from the SAME domain and Nginx reverse proxies /api -> backend,
# you can leave this empty or comment it out, and the client will use relative paths.
# If backend is on a different domain or subdomain, set it explicitly.
# Examples:
#   NEXT_PUBLIC_API_URL=https://api.artwala.org        # separate subdomain
#   NEXT_PUBLIC_API_URL=https://backend.otherhost.com  # external host
#   (omit entirely for same-origin proxy)
#
# NOTE: No trailing slash.
# NEXT_PUBLIC_API_URL=

#############################################
# 2. Site Metadata (optional, used for SEO / canonical tags)
#############################################
NEXT_PUBLIC_SITE_NAME=ArtWala
NEXT_PUBLIC_SITE_URL=https://artwala.org
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/placeholder.jpg

#############################################
# 3. Feature Flags (examples, toggle UI features)
#############################################
#NEXT_PUBLIC_ENABLE_MEMBERSHIP=true
#NEXT_PUBLIC_ENABLE_CHAT=true
#NEXT_PUBLIC_ENABLE_ANALYTICS=false

#############################################
# 4. Analytics / External Services (add only if used)
#############################################
#NEXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX
#NEXT_PUBLIC_SENTRY_DSN=...

#############################################
# 5. Media Handling
#############################################
# If media files are served from a CDN or different domain, specify it here.
# Otherwise they will resolve relative to API base (or same origin).
#NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.artwala.org

#############################################
# 6. Build-Time Flags
#############################################
# Enable React strict mode overrides or experimental features if needed.
#NEXT_PUBLIC_EXPERIMENTAL_UI=false

#############################################
# 7. Payment / Integration Placeholders
#############################################
# Add keys only if used and SAFE for public exposure (publishable keys only!).
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

#############################################
# 8. Local Development Overrides (example)
#############################################
# For local dev hitting Django running at 127.0.0.1:8000
# (Create a .env.local with this value uncommented)
#NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

#############################################
# 9. Security Notes
#############################################
# - Do NOT include: DB credentials, SMTP passwords, SECRET_KEY, or JWT secrets here.
# - Those belong only on the backend.
# - If you accidentally commit secrets, rotate them immediately.

#############################################
# 10. Troubleshooting
#############################################
# API calls returning 401 in production? Ensure tokens are stored and domain/origin matches.
# 404 on /api/... in production? Check Nginx proxy or NEXT_PUBLIC_API_URL correctness.
# Mixed content warnings? Ensure NEXT_PUBLIC_SITE_URL and API URL both use HTTPS.
